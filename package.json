{
  "name": "bugcapsule-web-workspace",
  "private": true,
  "description": "BugCapsule web SDK monorepo: @bugcapsule/web, @bugcapsule/react, @bugcapsule/web-replay, @bugcapsule/cli, @bugcapsule/emergency-guard and the shop demo.",
  "type": "module",
  "workspaces": [
    "packages/web",
    "packages/react",
    "packages/web-replay",
    "packages/cli",
    "packages/emergency-guard",
    "examples/shop"
  ],
  "scripts": {
    "build": "npm run build -w @bugcapsule/web -w @bugcapsule/react -w @bugcapsule/web-replay -w @bugcapsule/cli -w @bugcapsule/emergency-guard",
    "typecheck": "npm run typecheck -w @bugcapsule/web -w @bugcapsule/react -w @bugcapsule/web-replay -w @bugcapsule/cli -w @bugcapsule/emergency-guard",
    "test": "npm run test:size && npm run test:unit && npm run test:runner && npm run test:browser",
    "test:size": "node scripts/check-bundle-size.mjs",
    "test:unit": "node --import tsx --test 'test/unit/**/*.test.ts'",
    "test:runner": "node --import tsx --test 'test/replay-runner/*.test.ts'",
    "test:browser": "playwright test -c test/browser/playwright.config.ts",
    "pack:all": "mkdir -p dist-packages && npm pack -w @bugcapsule/web -w @bugcapsule/react -w @bugcapsule/web-replay -w @bugcapsule/cli -w @bugcapsule/emergency-guard --pack-destination dist-packages",
    "test:e2e:emergency-guard": "node --import tsx --test 'test/e2e/emergency-guard.e2e.test.ts'"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sentry/browser": "11.10.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
