{
  "name": "@bugcapsule/cli",
  "version": "0.4.0-beta.1",
  "description": "BugCapsule build tooling for the web: inject debug ids into bundles and source maps, upload source maps for symbolication.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bugcapsule-cli": "./bin/bugcapsule-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BugCapsule/bug_capsule_web_sdk",
    "directory": "packages/cli"
  },
  "keywords": [
    "bugcapsule",
    "sourcemaps",
    "debug-id",
    "symbolication"
  ]
}
