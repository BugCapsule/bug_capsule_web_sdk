{
  "name": "@bugcapsule/web-replay",
  "homepage": "https://bugcapsule.com",
  "version": "0.4.0-beta.4",
  "description": "Playwright runner that replays BugCapsule web capsules against the real app for the bugcapsule CLI.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bugcapsule-web-runner": "./bin/bugcapsule-web-runner.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bugcapsule/web": "0.4.0-beta.4",
    "playwright-core": "1.63.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BugCapsule/bug_capsule_web_sdk",
    "directory": "packages/web-replay"
  }
}
