{
  "name": "@bugcapsule/react",
  "homepage": "https://bugcapsule.com",
  "version": "0.4.0-beta.3",
  "description": "React helpers for the BugCapsule web SDK: actions, tracked inputs, state, error boundary and a React Router integration.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react-router": {
      "types": "./dist/react-router.d.ts",
      "import": "./dist/react-router.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@bugcapsule/web": "0.4.0-beta.3",
    "react": ">=18",
    "react-router": ">=6.4"
  },
  "peerDependenciesMeta": {
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bugcapsule/web": "0.4.0-beta.3",
    "@types/react": "^19.2.0",
    "react": "19.2.9",
    "react-router": "7.18.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BugCapsule/bug_capsule_web_sdk",
    "directory": "packages/react"
  }
}
