{
  "name": "@bugcapsule/web",
  "version": "0.3.0",
  "description": "BugCapsule web SDK: capture failures in the browser as portable .bugcapsule capsules and replay them against the real app with the bugcapsule CLI.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/draz26648/bug_capsule_web_sdk",
    "directory": "packages/web"
  },
  "keywords": [
    "bugcapsule",
    "replay",
    "debugging",
    "qa",
    "regression"
  ]
}
